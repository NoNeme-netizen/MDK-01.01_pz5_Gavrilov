<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- Строка подключения к базе данных PhotoCenter.
       Data Source — имя вашего экземпляра SQL Server (см. SSMS), Initial Catalog — имя БД. -->
  <connectionStrings>
    <add name="PhotoCenterDb"
         connectionString="Data Source=LAPTOP-D72RIGJN\SQLEXPRESS01;Initial Catalog=PhotoCenter;Integrated Security=True;Application Name=PhotoCenterRegistration"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
